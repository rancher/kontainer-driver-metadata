#!/bin/bash

# Upstream rancher source for the provisioning tests and CI helper scripts. Update RANCHER_REF
# when branching for a new release line.
RANCHER_REPO=${RANCHER_REPO:-rancher/rancher}
RANCHER_REF=${RANCHER_REF:-release/v2.16}

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    DIRTY="-dirty"
fi

COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)

GIT_TAG=$(git tag -l --contains HEAD | head -n 1)
if [[ "$GITHUB_EVENT_NAME" = "push" && "$GITHUB_REF_TYPE" = "tag" ]]; then
  GIT_TAG=$GITHUB_REF_NAME
fi

if [[ -z "$DIRTY" && -n "$GIT_TAG" ]]; then
    VERSION=$GIT_TAG
else
    VERSION="${COMMIT}${DIRTY}"
fi

if [ -z "$ARCH" ]; then
    ARCH=$(go env GOHOSTARCH 2>/dev/null || echo amd64)
fi

SUFFIX="-${ARCH}"
TAG=${TAG:-${VERSION}}
REPO=${REPO:-rancher}

if echo $TAG | grep -q dirty; then
    TAG=dev
fi