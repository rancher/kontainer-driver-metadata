{
	"linters": {
		"disable-all": true,
		"enable": [
			"govet",
			"revive",
			"goimports",
			"misspell",
			"ineffassign",
			"gofmt"
		]
	},
	"run": {
		"deadline": "5m"
	},
    "issues": {
        "exclude-rules": [
            {
                "text:" "/zz_generated_*"
            },
            {
                "linters": "revive",
                "text": "should have comment or be unexported"
            },
            {
                "path":"rke/templates/calico.go",
                "text":".*requried.*"
            },
            {
                "path":"rke/templates/canal.go",
                "text":".*compatiblity.*"
            },
            {
                "path":"rke/templates/canal.go",
                "text":".*requried.*"
            },

            {
                "path":"rke/templates/flannel.go",
                "text":".*unsed.*"
            },
            {
                "path":"rke/templates/nginx-ingress.go",
                "text":".*permissable.*"
            }
        ]
    }
}
